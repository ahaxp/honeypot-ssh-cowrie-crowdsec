# 1. Skopiuj ten plik jako .env:
# cp .env.example .env
#
# 2. Wygeneruj klucz dla bouncera:
# docker compose exec crowdsec cscli bouncers add firewall-bouncer
#
# 3. Wklej klucz z terminala do pliku .env 
CROWDSEC_BOUNCER_API_KEY=tu_wklej_swoj_klucz

# 4. Wygeneruj klucz dla AbuseIPDB:
# Zarejestruj się na https://www.abuseipdb.com/register i wygeneruj klucz API w ustawieniach konta. Wklej go poniżej.
ABUSEIPDB_API_KEY=tutaj_klucz